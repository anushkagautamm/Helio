# Base URL for the Helio API.
#
# Leave unset for local dev (uses Vite's /api proxy to the local backend,
# see vite.config.ts) or when the backend is reverse-proxied under the same
# domain as this frontend in production.
#
# Set this when the frontend and backend are deployed on different domains
# — e.g. this app hosted on Netlify with the backend on a separate host —
# to the backend's full origin, including /api:
# VITE_API_BASE_URL=https://helio-api.example.com/api
